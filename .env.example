# =============================================================================
# KELEME environment
#
# Copy to .env.local for development. Never commit a filled-in copy: the
# service-role key below bypasses every row-level security policy in the
# database, and treating it as a password is the single most important
# operational rule in this project.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.

# Safe to expose. Shipped to the browser by design.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# SECRET. Server-side only — bypasses RLS entirely.
# Used in exactly four places (see src/lib/supabase/admin.ts): signing private
# PDF URLs after an entitlement check, the payment webhook, session revocation,
# and the seed script. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Deployment ---------------------------------------------------------------
# Absolute base URL of this deployment. Used for auth redirects, OG metadata
# and referral links, so it must match the domain students actually visit.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seeding ------------------------------------------------------------------
# Only read by `npm run seed`. Set a strong password (12+ characters), run the
# seed once, then have each administrator change their own password at their
# first sign-in. Remove this value from your local file afterwards.
KELEME_ADMIN_PASSWORD="change-me-before-seeding"

# The three initial administrators. The defaults in scripts/seed.ts are only a
# starting point — override them here with real values before seeding.
#
# The PHONE numbers matter most: profiles.phone is unique-indexed, so a
# placeholder left in place permanently blocks that person from registering
# with their real number. Set them, or correct them afterwards in
# Admin -> Students.
# KELEME_ADMIN_LEWI_EMAIL="lewiterefe@gmail.com"
# KELEME_ADMIN_LEWI_PHONE="09XXXXXXXX"
# KELEME_ADMIN_FAHMI_EMAIL="keleme2026@gmail.com"
# KELEME_ADMIN_FAHMI_PHONE="09XXXXXXXX"
# KELEME_ADMIN_DAWIT_EMAIL="dsemere737@gmail.com"
# KELEME_ADMIN_DAWIT_PHONE="09XXXXXXXX"

# --- Payments (not yet connected) ---------------------------------------------
# The subscription architecture is provider-agnostic and ready for an adapter;
# no provider is wired up in this release. See docs/PAYMENTS.md for what
# integrating one involves. Leave these unset until then.
# PAYMENT_PROVIDER="chapa"
# PAYMENT_SECRET_KEY=""
# PAYMENT_WEBHOOK_SECRET=""
